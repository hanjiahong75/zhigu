# DeepSeek API Key (required)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: WeChat webhook auth
# WECHAT_WEBHOOK_API_KEY=your_secret_key

# Optional: ChromaDB config
# CHROMA_DB_PATH=./chroma_db
# CHROMA_COLLECTION=stock_analyses

# Optional: WeChat timeout (seconds)
# CHAT_TIMEOUT_SECONDS=25

# Optional: Max history pairs for WeChat
# MAX_HISTORY_PAIRS=10

# JWT 签名密钥（必填，缺失或服务使用默认兜底值时后端拒绝启动）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
